{
  "name": "fasedocument-tracker",
  "version": "1.0.0-migration.1",
  "description": "1828 Fasedocument Tracker — Electron + TypeScript port of the Kotlin/JavaFX desktop app",
  "main": "out/main/index.js",
  "private": true,
  "author": "1828",
  "scripts": {
    "dev": "npm run rebuild:electron && node scripts/dev-launch.cjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "pretest": "npm run rebuild:node",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:import": "tsx scripts/import-phases.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "dist": "electron-vite build && electron-builder",
    "web:build": "vite build -c web/vite.config.ts",
    "web:dev": "vite -c web/vite.config.ts",
    "preweb:server": "npm run rebuild:node",
    "web:server": "tsx web/server.ts",
    "preweb:start": "npm run rebuild:node",
    "web:start": "npm run web:build && tsx web/server.ts",
    "web:server:demo": "SEED_DEMO=1 tsx web/server.ts",
    "preweb:server:demo": "npm run rebuild:node"
  },
  "dependencies": {
    "@types/express": "^4.17.25",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "drizzle-orm": "^0.38.4",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "nodemailer": "^6.9.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "drizzle-kit": "^0.30.6",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.3",
    "tsx": "^4.17.0",
    "typescript": "~5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
