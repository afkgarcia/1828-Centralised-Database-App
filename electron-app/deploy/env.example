# /etc/1828-tracker.env — environment for the systemd unit (chmod 600, root-owned).

NODE_ENV=production
PORT=8028
# The app binds loopback by default (only Caddy reaches it). Set HOST=0.0.0.0
# only if the proxy runs on another machine.
#HOST=127.0.0.1
DATA_DIR=/var/lib/1828-tracker

# First-boot owner (only used while the users table is empty — see DEPLOY.md;
# remove the password line after the first successful login).
BOOTSTRAP_OWNER_EMAIL=ernest@vivout.nl
BOOTSTRAP_OWNER_PASSWORD=change-me-before-first-boot
BOOTSTRAP_OWNER_NAME=Ernest

# Max auth attempts per IP per 5 minutes (login/signup/reset).
AUTH_RATE_LIMIT=10

# NEVER set SEED_DEMO=1 on a production install — it creates the demo world
# with well-known credentials.
